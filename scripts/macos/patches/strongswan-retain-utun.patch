+#endif
+
 #define TUN_DEFAULT_MTU 1400
 
+#ifdef __APPLE__
+#define VPNT_CHANNEL_FD 3
+#define VPNT_CHANNEL_SEND_RETRIES 8
+
+/**
+ * Mark the inherited channel close-on-exec before any other use.
+ */
+static bool vpnt_channel_prepare()
+{
+	int flags = fcntl(VPNT_CHANNEL_FD, F_GETFD);
+
+	if (flags < 0)
+	{
+		return FALSE;
+	}
+	return fcntl(VPNT_CHANNEL_FD, F_SETFD, flags | FD_CLOEXEC) == 0;
+}
+
+/**
+ * Require an anonymous connected AF_UNIX SOCK_DGRAM.
+ */
+static bool vpnt_channel_connected()
+{
+	struct sockaddr_un local = { 0 }, peer = { 0 };
+	socklen_t length, size;
+	size_t path;
+	int type;
+
+	path = offsetof(struct sockaddr_un, sun_path);
+	length = sizeof(local);
+	if (getsockname(VPNT_CHANNEL_FD, (struct sockaddr*)&local, &length) != 0 ||
+		local.sun_family != AF_UNIX ||
+		length < path || length > sizeof(local) ||
+		(length > path && local.sun_path[0] != '\0'))
+	{
+		return FALSE;
+	}
+	length = sizeof(peer);
+	if (getpeername(VPNT_CHANNEL_FD, (struct sockaddr*)&peer, &length) != 0 ||
+		peer.sun_family != AF_UNIX ||
+		length < path || length > sizeof(peer) ||
+		(length > path && peer.sun_path[0] != '\0'))
+	{
+		return FALSE;
+	}
+	size = sizeof(type);
+	if (getsockopt(VPNT_CHANNEL_FD, SOL_SOCKET, SO_TYPE, &type, &size) != 0 ||
+		size != sizeof(type) || type != SOCK_DGRAM)
+	{
+		return FALSE;
+	}
+	return TRUE;
+}
+
+/**
+ * Send the original TUN fd once, non-blocking, with the fixed VPUFv1 payload.
+ */
+static bool vpnt_send_utun(int fd)
+{
+	char payload[8] = { 0x56, 0x50, 0x55, 0x46, 1, 0, 0, 0 };
+	char control[CMSG_SPACE(sizeof(int))];
+	struct iovec iov;
+	struct msghdr message;
+	struct cmsghdr *cmsg;
+	int one = 1;
+	int flags;
+	int attempt;
+
+	/* Prevent the original TUN fd from leaking into a later exec. */
+	flags = fcntl(fd, F_GETFD);
+	if (flags < 0 || fcntl(fd, F_SETFD, flags | FD_CLOEXEC) < 0)
+	{
+		return FALSE;
+	}
+
+	if (!vpnt_channel_connected() ||
+		setsockopt(VPNT_CHANNEL_FD, SOL_SOCKET, SO_NOSIGPIPE, &one,
+				   sizeof(one)) != 0)
+	{
+		return FALSE;
+	}
+	memset(&message, 0, sizeof(message));
+	iov.iov_base = payload;
+	iov.iov_len = sizeof(payload);
+	message.msg_iov = &iov;
+	message.msg_iovlen = 1;
+	message.msg_control = control;
+	message.msg_controllen = sizeof(control);
+	cmsg = CMSG_FIRSTHDR(&message);
+	if (!cmsg)
+	{
+		return FALSE;
+	}
+	cmsg->cmsg_level = SOL_SOCKET;
+	cmsg->cmsg_type = SCM_RIGHTS;
+	cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(cmsg), &fd, sizeof(fd));
+	for (attempt = 0; attempt < VPNT_CHANNEL_SEND_RETRIES; attempt++)
+	{
+		if (sendmsg(VPNT_CHANNEL_FD, &message, MSG_DONTWAIT) ==
+			(ssize_t)sizeof(payload))
+		{
+			return TRUE;
+		}
+		if (errno != EINTR)
+		{
+			return FALSE;
+		}
+	}
+	return FALSE;
+}
+#endif
+
