--- a/src/tunnel.c
+++ b/src/tunnel.c
@@ -1430,6 +1430,45 @@
 	else
 		log_info("vpnt: split-routes %d\n", tunnel.ipv4.split_routes);
 
+	/* Emit bounded numeric DNS values and validated domain tokens only. */
+	int dns_servers = 0, dns_domains = 0, dns_invalid = 0;
+	struct in_addr servers[2] = { tunnel.ipv4.ns1_addr, tunnel.ipv4.ns2_addr };
+	for (int i = 0; i < 2; i++) {
+		char address[INET_ADDRSTRLEN];
+		if (servers[i].s_addr == 0)
+			continue;
+		if (!inet_ntop(AF_INET, &servers[i], address, sizeof(address))) {
+			dns_invalid = 1;
+			continue;
+		}
+		log_info("vpnt: dns-server %s\n", address);
+		dns_servers++;
+	}
+	const char *domain = tunnel.ipv4.dns_suffix;
+	while (domain && *domain) {
+		while (*domain == ';' || *domain == ' ')
+			domain++;
+		if (!*domain)
+			break;
+		const char *start = domain;
+		while (*domain && *domain != ';' && *domain != ' ') {
+			unsigned char c = (unsigned char)*domain++;
+			if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+			      (c >= '0' && c <= '9') || c == '.' || c == '-'))
+				dns_invalid = 1;
+		}
+		size_t length = (size_t)(domain - start);
+		if (length > 253 || dns_domains >= 8 || dns_invalid) {
+			dns_invalid = 1;
+			break;
+		}
+		log_info("vpnt: dns-domain %.*s\n", (int)length, start);
+		dns_domains++;
+	}
+	if (dns_invalid)
+		log_info("vpnt: dns invalid\n");
+	log_info("vpnt: dns %d %d\n", dns_servers, dns_domains);
+
 	// Step 4: run a pppd process
 	log_debug("Establishing the tunnel\n");
 	ret = pppd_run(&tunnel);
