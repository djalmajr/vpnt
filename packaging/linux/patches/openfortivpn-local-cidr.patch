+++ b/src/vpnt_ipcp_policy.h
@@ -0,0 +1,29 @@
+#ifndef VPNT_IPCP_POLICY_H
+#define VPNT_IPCP_POLICY_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define VPNT_IPCP_DENIED_EXIT 3
+
+struct vpnt_ipcp_local_scope {
+	uint32_t network;
+	uint8_t prefix;
+};
+
+struct vpnt_ipcp_ack {
+	uint32_t local;
+	uint32_t dns1;
+	uint32_t dns2;
+};
+
+bool vpnt_ipcp_local_scope_parse(const char *text,
+                               struct vpnt_ipcp_local_scope *scope);
+bool vpnt_ipcp_local_scope_allows(const struct vpnt_ipcp_local_scope *scope,
+                                 const uint8_t *frame, size_t size);
+bool vpnt_ipcp_check(const struct vpnt_ipcp_local_scope *scope,
+                    const uint8_t *frame, size_t size,
+                    struct vpnt_ipcp_ack *ack);
+
+#endif
