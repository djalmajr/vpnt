diff --git a/src/vpnt_ipcp_policy.c b/src/vpnt_ipcp_policy.c
new file mode 100644
--- /dev/null
+++ b/src/vpnt_ipcp_policy.c
@@ -0,0 +1,170 @@
+#include "vpnt_ipcp_policy.h"
+
+#include <arpa/inet.h>
+#include <string.h>
+
+/* The scope and the inspection result use host byte order. */
+static uint32_t mask(unsigned prefix)
+{
+	return UINT32_MAX << (32 - prefix);
+}
+
+static uint32_t address(const uint8_t *bytes)
+{
+	uint32_t network_order;
+
+	memcpy(&network_order, bytes, sizeof(network_order));
+	return ntohl(network_order);
+}
+
+bool vpnt_ipcp_local_scope_parse(const char *text,
+                               struct vpnt_ipcp_local_scope *scope)
+{
+	char ipv4[INET_ADDRSTRLEN];
+	const char *slash = strchr(text, '/');
+	struct in_addr parsed;
+	unsigned prefix;
+	uint32_t network;
+	static const struct vpnt_ipcp_local_scope excluded[] = {
+		{ 0x00000000, 8 }, { 0x7f000000, 8 }, { 0xa9fe0000, 16 },
+		{ 0xe0000000, 4 }, { 0xf0000000, 4 },
+	};
+
+	if (!slash || slash == text || (size_t)(slash - text) >= sizeof(ipv4))
+		return false;
+	memcpy(ipv4, text, slash - text);
+	ipv4[slash - text] = '\0';
+	if (inet_pton(AF_INET, ipv4, &parsed) != 1)
+		return false;
+
+	text = slash + 1;
+	if (*text < '1' || *text > '9')
+		return false;
+	prefix = *text++ - '0';
+	if (*text >= '0' && *text <= '9')
+		prefix = prefix * 10 + (*text++ - '0');
+	if (*text || prefix < 8 || prefix > 32)
+		return false;
+
+	network = ntohl(parsed.s_addr);
+	if ((network & mask(prefix)) != network)
+		return false;
+	for (size_t i = 0; i < sizeof(excluded) / sizeof(excluded[0]); i++) {
+		unsigned common = prefix < excluded[i].prefix ? prefix : excluded[i].prefix;
+		if ((network & mask(common)) == (excluded[i].network & mask(common)))
+			return false;
+	}
+	*scope = (struct vpnt_ipcp_local_scope){ network, prefix };
+	return true;
+}
+
+/*
+ * Protocols that can hand pppd a control frame this barrier never saw:
+ * compression negotiation and its datagrams, and multilink fragments.
+ * pppd runs with CCP off, so a gateway that sends one is not following the
+ * negotiation and the attempt ends. Protocol-field-compressed frames carry
+ * only the low byte.
+ */
+static bool wraps_control(uint16_t protocol)
+{
+	switch (protocol) {
+	case 0x003d: /* Multilink fragment */
+	case 0x00fb: /* Individual-link compressed datagram */
+	case 0x00fd: /* Compressed datagram */
+	case 0x80fb: /* Individual-link CCP */
+	case 0x80fd: /* CCP */
+		return true;
+	}
+	return false;
+}
+
+bool vpnt_ipcp_check(const struct vpnt_ipcp_local_scope *scope,
+                    const uint8_t *frame, size_t size,
+                    struct vpnt_ipcp_ack *ack)
+{
+	enum { CONFREQ = 1, CONFACK = 2, CONFNAK = 3 };
+	enum { CI_ADDRS = 1, CI_ADDR = 3, CI_DNS1 = 129, CI_DNS2 = 131 };
+	struct vpnt_ipcp_ack result = {0};
+	bool seen_address = false;
+	uint8_t code;
+
+	*ack = result;
+	/* This payload starts at PPP Protocol; HDLC adds Address/Control. */
+	if (!size || frame[0] == 0xff)
+		return false;
+	if (frame[0] & 1) /* Compressed protocol; IPCP cannot be compressed. */
+		return !wraps_control(frame[0]);
+	if (size < 2 || !(frame[1] & 1))
+		return false;
+	if (wraps_control((uint16_t)(frame[0] << 8 | frame[1])))
+		return false;
+	if (frame[0] != 0x80 || frame[1] != 0x21)
+		return true;
+	if (size < 6 || ((size_t)frame[4] << 8 | frame[5]) != size - 2)
+		return false;
+
+	code = frame[2];
+	if (code != CONFREQ && code != CONFACK && code != CONFNAK)
+		return true;
+
+	for (size_t offset = 6; offset < size; ) {
+		const uint8_t *option = frame + offset;
+		const uint8_t *local = NULL;
+		size_t length;
+
+		if (size - offset < 2)
+			return false;
+		length = option[1];
+		if (length < 2 || length > size - offset)
+			return false;
+		offset += length;
+
+		switch (option[0]) {
+		case CI_ADDRS:
+			if (length != 10 || seen_address)
+				return false;
+			seen_address = true;
+			/* The first address belongs to the Configure-Request sender. */
+			local = option + (code == CONFREQ ? 6 : 2);
+			break;
+		case CI_ADDR:
+			if (length != 6 || seen_address)
+				return false;
+			seen_address = true;
+			if (code != CONFREQ)
+				local = option + 2;
+			break;
+		case CI_DNS1:
+		case CI_DNS2:
+			if (length != 6)
+				return false;
+			if (code == CONFACK) {
+				if (option[0] == CI_DNS1)
+					result.dns1 = address(option + 2);
+				else
+					result.dns2 = address(option + 2);
+			}
+			break;
+		}
+
+		if (local) {
+			uint32_t ip = address(local);
+
+			if (scope->prefix < 8 || scope->prefix > 32
+			    || (ip & mask(scope->prefix)) != scope->network)
+				return false;
+			if (code == CONFACK)
+				result.local = ip;
+		}
+	}
+	*ack = result;
+	return true;
+}
+
+bool vpnt_ipcp_local_scope_allows(const struct vpnt_ipcp_local_scope *scope,
+                                 const uint8_t *frame, size_t size)
+{
+	struct vpnt_ipcp_ack ack;
+
+	return vpnt_ipcp_check(scope, frame, size, &ack);
+}
