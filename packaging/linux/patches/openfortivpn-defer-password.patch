+			              config->password, PASSWORD_SIZE);
+			password_unavailable = config->password[0] == '\0';
+		}
+		if (getsockname(3, (struct sockaddr *)&capability, &capability_len) == 0
+		    && capability.ss_family == AF_UNIX)
+			close(3);
+		if (timed_login) {
+			int timer_status = timerfd_gettime(4, &login_timer);
+
+			close(4);
+			if (timer_status < 0 || (login_timer.it_value.tv_sec == 0
+			                        && login_timer.it_value.tv_nsec == 0)) {
+				log_error("VPN establishment deadline expired or unavailable.\n");
+				ssl_disconnect(&tunnel);
+				return 1;
+			}
+		}
+		if (password_unavailable) {
+			log_error("VPN account password is unavailable from pinentry.\n");
+			ssl_disconnect(&tunnel);
+			return 1;
+		}
+	}
