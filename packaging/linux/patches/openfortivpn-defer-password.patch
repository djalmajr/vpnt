+	// vpnt: ssl_connect only succeeds after ssl_verify_cert accepted the
+	// gateway's certificate (the mandatory --trusted-cert pin), so the password
+	// is not asked, and not sent, before that. The pinentry's one-shot socket
+	// (descriptor 3, an AF_UNIX socket) is then closed here, before any other
+	// process (the pppd below, an OTP pinentry) can inherit it.
+	if (config->pinentry && *config->pinentry) {
+		struct sockaddr_storage capability;
+		socklen_t capability_len = sizeof(capability);
+		struct itimerspec login_timer;
+		int timed_login = config->vpnt_ifindex != 0;
+		int password_unavailable = 0;
+
+		// The writer's absolute CLOCK_MONOTONIC timer is inherited on
+		// FD 4 for vpnt's bound transport. Pinentry only needs FD 3.
+		if (timed_login && fcntl(4, F_SETFD, FD_CLOEXEC) < 0)
+			password_unavailable = 1;
+
+		if (!password_unavailable && !config->password_set
+		    && config->username[0] != '\0'
+		    && !config->cookie && !config->saml_port
+		    && config->password[0] == '\0') {
+			char hint[USERNAME_SIZE + 1 + REALM_SIZE + 1 + GATEWAY_HOST_SIZE + 10];
+
+			sprintf(hint, "%s_%s_%s_password",
+			        config->username, config->realm, config->gateway_host);
+			read_password(config->pinentry, hint,
