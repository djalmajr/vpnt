[Unit]
Description=VPN Tray tunnel provider
Documentation=https://github.com/djalmajr/vpnt
Requires=vpnt-tunneld.socket
After=vpnt-tunneld.socket

[Service]
Type=simple
ExecStart=/usr/lib/vpnt/vpnt-tunneld
# The writer owns host route changes and talks to systemd and DNS services over Unix sockets.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/run/vpnt
ProtectHome=yes
PrivateTmp=yes
UMask=0077
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
LimitCORE=0
